# 校园安全智能监测平台 — 环境变量示例
# 复制为 .env 后填写；切勿将真实 .env 提交到公开仓库

SECRET_KEY=change-me-in-production-use-long-random-string
DATABASE_BACKEND=sqlite
DATABASE_PATH=data/campus_safety.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-after-deploy

# ---------- MySQL（DATABASE_BACKEND=mysql 时启用）----------
# DB_USER=campus_app
# DB_PASSWORD=your_strong_password
# DB_HOST=mysql.internal.example
# DB_PORT=3306
# DB_NAME=campus_safety
# DB_CHARSET=utf8mb4
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=1
# DB_SLOW_QUERY_MS=500
# SQLALCHEMY_ECHO=0
# APP_ENCRYPT_KEY=your_fernet_key_here

# ---------- 硬件统一上报（可选）----------
# HARDWARE_INGEST_TOKEN=your_hardware_ingest_token

# ---------- 各硬件模块上传鉴权（请求头 X-API-KEY）----------
# BLE_LOCATION_API_KEY=your_ble_api_key
# GPS_LOCATION_API_KEY=your_gps_api_key
# LD2450_INGEST_API_KEY=your_ld2450_key
# VOICE_INGEST_API_KEY=your_voice_key
# CAMERA_INGEST_API_KEY=your_camera_key
# SERIAL_ACTUATOR_API_KEY=your_actuator_key

# ---------- 串口与设备（按本机环境修改）----------
# SERIAL_PORT=COM3
# SERIAL_BAUD=115200
# SERIAL_ACTUATOR_PORT=COM4
# SERIAL_ACTUATOR_BAUD=115200
# PLATFORM_URL=http://127.0.0.1:5000
# DEVICE_ID=demo-device-01
# LOCATION=教学楼A-走廊

# ---------- 心率/血氧上传（tools/health_uploader.py）----------
# HEALTH_SERIAL_PORT=COM3
# USER_ID=1
# HEALTH_INGEST_TOKEN=
# HEALTH_INGEST_SKIP_AI=1

# ---------- 蓝牙定位区域标签（展示用）----------
# BLE_ZONE_MODE=by_x
# BLE_X_THRESHOLD_1=9.0
# BLE_X_THRESHOLD_2=12.0
# BLE_ZONE_LEFT_LABEL=区域A
# BLE_ZONE_MID_LABEL=区域B
# BLE_ZONE_RIGHT_LABEL=区域C

# ---------- 平台级 AI：豆包（仅平台后端）----------
# DOUBAO_API_KEY=
# DOUBAO_MODEL_ID=doubao-seed-2-0-lite-260215
# DOUBAO_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses

# ---------- 其它（可选）----------
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# SMS_WEBHOOK_URL=
# CAMERA_STREAM_URLS=
