# 校园安全智能监测平台 — 环境变量示例（复制为 .env 后填写，勿提交密钥到版本库）
SECRET_KEY=change-me-in-production
DATABASE_PATH=data/campus_safety.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-demo-password

# ---------- 数据库后端（sqlite | mysql）----------
DATABASE_BACKEND=sqlite
# DB_USER=your_db_user
# DB_PASSWORD=your_strong_password
# DB_HOST=your.db.host.example
# DB_PORT=3306
# DB_NAME=campus_safety
# DB_CHARSET=utf8mb4
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=30
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=1
# DB_SLOW_QUERY_MS=500
# SQLALCHEMY_ECHO=0
# APP_ENCRYPT_KEY=your_fernet_key

# ---------- 硬件统一上报（可选）----------
# 若设置，则 POST /api/hardware/data 必须在请求头携带相同令牌
# X-Hardware-Token: <token>  或  Authorization: Bearer <token>
# HARDWARE_INGEST_TOKEN=

# 蓝牙定位上传鉴权（POST /api/ble/location/upload）
# 请求头 X-API-KEY 必须与 BLE_LOCATION_API_KEY 一致
# BLE_LOCATION_API_KEY=your_ble_api_key

# GPS 定位上传鉴权（POST /api/gps/location/upload）
# GPS_LOCATION_API_KEY=your_gps_api_key

# HLK-LD2450 毫米波雷达上传（POST /api/ld2450/upload，请求头 X-API-KEY）
# LD2450_INGEST_API_KEY=your_ld2450_key

# HK-ARRAYMIC 语音识别上传（POST /api/voice/upload，请求头 X-API-KEY）
# VOICE_INGEST_API_KEY=your_voice_key

# ESP32-CAM 摄像头上传（POST /api/camera/upload，请求头 X-API-KEY）
# CAMERA_INGEST_API_KEY=your_camera_key

# 串口执行器（POST /api/actuator/serial，请求头 X-API-KEY）
# SERIAL_ACTUATOR_API_KEY=your_actuator_key
# SERIAL_ACTUATOR_PORT=COM3
# SERIAL_ACTUATOR_BAUD=115200

# 蓝牙定位：区域推测（前端展示用，不影响入库）
# BLE_ZONE_MODE=by_x
# BLE_X_THRESHOLD_1=9.0
# BLE_X_THRESHOLD_2=12.0
# BLE_ZONE_LEFT_LABEL=区域A
# BLE_ZONE_MID_LABEL=区域B
# BLE_ZONE_RIGHT_LABEL=区域C

# ---------- 串口桥接脚本（tools/serial_to_platform.py，可选）----------
# SERIAL_PORT=COM3
# SERIAL_BAUD=115200
# PLATFORM_URL=http://127.0.0.1:5000
# DEVICE_ID=stm32-demo-01
# LOCATION=示例区域-走廊

# ---------- 心率/血氧 HTTP 入库（tools/health_uploader.py）----------
# HEALTH_SERIAL_PORT=COM3
# USER_ID=3
# HEALTH_INGEST_TOKEN=
# HEALTH_INGEST_SKIP_AI=1

# ---------- 平台级 AI：豆包 Doubao（仅平台后端，与硬件端隔离）----------
# DOUBAO_API_KEY=
# DOUBAO_MODEL_ID=doubao-seed-2-0-lite-260215
# DOUBAO_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses

# ---------- 其它（可选）----------
# SMS_WEBHOOK_URL=
# CAMERA_STREAM_URLS=
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
